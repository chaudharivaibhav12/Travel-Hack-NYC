# Copy to .env.local (gitignored) and fill in.
#
# NEXT_PUBLIC_* is intentional for these two: supabase-js runs in the browser,
# so the anon key must reach the client. It is public by design in every
# Supabase app — Row Level Security on each table is the security boundary.
# Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never prefixed with NEXT_PUBLIC_.
# The FastAPI backend. Keep all three values aligned with the port used by
# `uvicorn`; the documented local default is 8001.
WEATHER_API_BASE=http://127.0.0.1:8001

# Same FastAPI app, used by app/api/trips + app/api/preferences.
API_BASE=http://127.0.0.1:8001

# Browser-side group-trip requests use the same FastAPI process.
NEXT_PUBLIC_API_BASE=http://localhost:8001

# Copy to .env.local (gitignored) and fill in.
#
# NEXT_PUBLIC_* is intentional for these two: supabase-js runs in the browser,
# so the anon key must reach the client. It is public by design in every
# Supabase app — Row Level Security on each table is the security boundary.
# Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never prefixed with NEXT_PUBLIC_.
# The FastAPI backend (see backend/ — README's `uvicorn main:app --reload`
# defaults to 8000). Both vars point at the same process; only split into two
# names because app/api/weather predates trips/preferences. Match whatever
# port you actually started uvicorn on if it's not 8000.
WEATHER_API_BASE=http://127.0.0.1:8000

# Same FastAPI app, used by app/api/trips + app/api/preferences.
API_BASE=http://127.0.0.1:8000

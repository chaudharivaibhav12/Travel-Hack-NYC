SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
REDIRECT_URL=http://localhost:5173/auth/callback
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:3001

# Stay22 Direct Travel API key — get one at hub.stay22.com/en/settings/api
# Omit to run in demo mode (5 req/min per IP, no auth required)
STAY22_API_KEY=your-stay22-api-key

# Private itinerary generation. The model is optional.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5
